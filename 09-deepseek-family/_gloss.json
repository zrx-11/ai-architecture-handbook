  "chapterId": "ch01"
 },
 {
  "term": "稠密模型",
  "def": "每个 token 都走同一套 FFN 的模型",
  "chapterId": "ch01"
 },
 {
  "term": "MoE",
  "def": "混合专家：FFN 拆成多个专家，每个 token 只走 top-k",
  "chapterId": "ch01"
 },
 {
  "term": "路由专家",
  "def": "由门控选择是否激活的专家",
  "chapterId": "ch01"
 },
 {
  "term": "共享专家",
  "def": "始终激活、负责通用知识的专家",
  "chapterId": "ch03"
 },
 {
  "term": "门控",
  "def": "给 token 和专家打分、决定路由的模块",
  "chapterId": "ch03"
 },
 {
  "term": "top-k",
  "def": "每个 token 只选分数最高的 k 个专家",
  "chapterId": "ch03"
 },
 {
  "term": "总参数",
  "def": "模型全部权重数量，决定显存",
  "chapterId": "ch01"
 },
 {
  "term": "激活参数",
  "def": "每个 token 实际参与计算的权重数量，决定算力",
  "chapterId": "ch01"
 },
 {
  "term": "专家并行",
  "def": "把不同专家放到不同设备上的并行方式",
  "chapterId": "ch03"
 },
 {
  "term": "负载均衡",
  "def": "让各专家处理量接近，避免专家塌缩",
  "chapterId": "ch03"
 },
 {
  "term": "专家塌缩",
  "def": "门控总选少数专家，其余专家学不到东西",
  "chapterId": "ch03"
 },
 {
  "term": "辅助损失",
  "def": "加在主损失外、用来拉平专家负载的损失项",
  "chapterId": "ch03"
 },
 {
  "term": "无辅助损失均衡",
  "def": "用可学习专家偏置代替辅助损失的均衡方法",
  "chapterId": "ch05"
 },
 {
