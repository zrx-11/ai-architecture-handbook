  "quizzes": [
    {
      "id": "q01",
      "chapterId": "ch01",
      "type": "single",
      "question": "这份总库最适合怎么用？",
      "options": [
        "从 1 到 114 按编号背完",
        "把它当回查索引，按问题定位机制",
        "只看公式，不看机制",
        "用它替代所有分册"
      ],
      "answer": 1,
      "explain": "编号是索引，不是学习顺序；先定位问题再回主手册深读。"
    },
    {
      "id": "q02",
      "chapterId": "ch01",
      "type": "single",
      "question": "114 个机制被分成几组？",
      "options": [
        "6 组",
        "7 组",
        "9 组",
        "12 组"
      ],
      "answer": 2,
      "explain": "模型架构、变体、预训练、后训练、解码、推理、生成、应用、安全，共九组。"
    },
    {
      "id": "q03",
      "chapterId": "ch02",
      "type": "single",
      "question": "BPE 分词的核心操作是？",
      "options": [
        "把每个字符单独作为一个 token",
        "反复合并最高频相邻字符对",
        "用固定词表查表",
        "按语法树切分"
      ],
      "answer": 1,
      "explain": "BPE 从字符表开始，统计并合并最高频相邻对，高频词整词一个 token。"
    },
    {
      "id": "q04",
      "chapterId": "ch02",
      "type": "single",
      "question": "GQA 主要压缩哪一份账？",
      "options": [
        "注意力 FLOPs",
        "KV cache 显存",
        "FFN 参数",
        "词表大小"
      ],
      "answer": 1,
      "explain": "GQA 让多个查询头共享 K/V，省 KV cache 显存与带宽，不省注意力 FLOPs。"
    },
    {
      "id": "q05",
      "chapterId": "ch02",
      "type": "single",
      "question": "MLA 的代价是什么？",
      "options": [
        "完全不能长上下文",
        "多一次投影矩阵乘",
        "必须放弃 MoE",
        "只能训练不能推理"
      ],
      "answer": 1,
      "explain": "MLA 把 K/V 压成低秩潜向量，省 KV 显存；用时投影回来，多一次矩阵乘。"
    },
    {
      "id": "q06",
      "chapterId": "ch03",
      "type": "single",
      "question": "数据并行（DP）的主要限制是？",
      "options": [
        "每卡仍要一份完整权重",
        "只能单卡运行",
        "不能同步梯度",
        "只支持 CNN"
      ],
      "answer": 0,
      "explain": "DP 分摊数据，不分摊权重；每卡仍持有完整模型。"
    },
    {
      "id": "q07",
      "chapterId": "ch03",
      "type": "single",
      "question": "长上下文训练最先爆的常是？",
      "options": [
        "词表",
        "激活显存",
        "磁盘",
        "CPU"
      ],
      "answer": 1,
      "explain": "序列并行与梯度检查点都在处理激活；长序列激活常是最大一块。"
    },
    {
      "id": "q08",
      "chapterId": "ch03",
      "type": "single",
      "question": "loss spike 的合理急救顺序是？",
      "options": [
        "直接换模型",
        "梯度裁剪、降学习率、回滚检查点，再查数据",
        "只加大 batch",
        "忽略继续训"
      ],
      "answer": 1,
      "explain": "先稳住训练，再定位数据或数值问题。"
    },
    {
      "id": "q09",
      "chapterId": "ch04",
      "type": "single",
      "question": "RLVR 的前提是？",
      "options": [
        "有大量人工偏好标注",
        "任务能自动判对错",
        "必须训练奖励模型",
        "只能做对话"
      ],
      "answer": 1,
      "explain": "RLVR 把答案交给验证器；没有可验证环境就无法给奖励。"
    },
    {
      "id": "q10",
      "chapterId": "ch04",
      "type": "single",
      "question": "DPO 相比 RLHF 少了什么？",
      "options": [
        "偏好数据",
        "奖励模型与在线采样",
        "参考策略",
        "SFT"
      ],
      "answer": 1,
      "explain": "DPO 直接用偏好对算分类损失，省掉奖励模型和在线采样。"
    },
    {
      "id": "q11",
      "chapterId": "ch04",
      "type": "single",
      "question": "推测解码在什么情况下可能倒亏？",
      "options": [
        "接受率很低",
        "显存很大",
        "上下文很短",
        "batch=1"
      ],
      "answer": 0,
      "explain": "接受率低时草稿大量被拒，开销超过收益。"
    },
    {
      "id": "q12",
      "chapterId": "ch05",
      "type": "single",
      "question": "PagedAttention 主要解决？",
      "options": [
        "KV cache 显存碎片",
        "词表外 token",
        "梯度爆炸",
        "数据重复"
      ],
      "answer": 0,
      "explain": "借虚拟内存分页，把 KV 切成固定块按需分配。"
    },
    {
      "id": "q13",
      "chapterId": "ch05",
      "type": "single",
      "question": "prefill 与 decode 的特性分别是？",
      "options": [
        "都算力密集",
        "都带宽密集",
        "prefill 算力密集，decode 带宽密集",
        "prefill 带宽密集，decode 算力密集"
      ],
      "answer": 2,
      "explain": "prefill 一次处理整段 prompt，是大矩阵乘；decode 逐 token，受带宽约束。"
    },
    {
      "id": "q14",
      "chapterId": "ch05",
      "type": "single",
      "question": "KV 驱逐时必须保留哪些 token？",
      "options": [
        "所有停用词",
        "开头几个 Attention Sink",
        "最后一个 token",
        "随机 token"
      ],
      "answer": 1,
      "explain": "开头几个 token 是注意力落脚点，丢掉会让整段注意力失准。"
    },
    {
      "id": "q15",
      "chapterId": "ch06",
      "type": "single",
      "question": "RAG 链路中最影响召回质量的一步是？",
      "options": [
        "生成温度",
        "切块与嵌入",
        "标点",
        "模型参数量"
      ],
      "answer": 1,
      "explain": "切块决定颗粒度，嵌入决定语义召回；生成不是召回瓶颈。"
    },
    {
      "id": "q16",
      "chapterId": "ch06",
      "type": "single",
      "question": "提示注入攻击的核心结构缺陷是？",
      "options": [
        "模型参数太小",
        "模型分不清数据与指令",
        "词表太大",
        "上下文太短"
      ],
      "answer": 1,
      "explain": "上下文里所有 token 一律平等，第三方数据里的指令会被当指令执行。"
    },
    {
      "id": "q17",
      "chapterId": "ch06",
      "type": "single",
      "question": "越狱与提示注入的区别是？",
      "options": [
        "完全一样",
        "越狱由用户发起，注入藏在数据里",
        "越狱只攻击图像",
        "注入只攻击训练集"
      ],
      "answer": 1,
      "explain": "越狱是用户自己想让模型说禁区内容；注入是第三方把指令藏进模型会读的数据。"
    },
    {
      "id": "q18",
      "chapterId": "ch07",
      "type": "single",
      "question": "图像 1024×1024、patch 14，token 数约多少？",
      "options": [
        "约 5,400",
        "约 1,000",
        "约 73",
        "约 14,000"
      ],
      "answer": 0,
      "explain": "(1024/14)² ≈ 73² ≈ 5,400。"
    },
    {
      "id": "q19",
      "chapterId": "ch07",
      "type": "single",
      "question": "GQA 的 KV 缩减比是？",
      "options": [
        "n_h/n_kv",
        "n_kv/n_h",
        "d_head/d",
        "h/d"
      ],
      "answer": 1,
      "explain": "KV 头数除以查询头数；n_h=32、n_kv=8 时缩到 1/4。"
    },
    {
      "id": "q20",
      "chapterId": "ch08",
      "type": "single",
      "question": "7B 模型按 16 字节/参数估训练显存约多少？",
      "options": [
        "14 GB",
        "56 GB",
        "112 GB",
        "224 GB"
      ],
      "answer": 2,
      "explain": "7e9×16 B≈112 GB，还没算激活。"
    },
    {
      "id": "q21",
      "chapterId": "ch08",
      "type": "single",
      "question": "梯度累积的等效 batch 是？",
      "options": [
        "micro-batch×accum×DP",
        "micro-batch+accum",
        "micro-batch/accum",
        "只等于 micro-batch"
      ],
      "answer": 0,
      "explain": "梯度累积把多次 micro-batch 的梯度加起来再更新。"
    },
    {
      "id": "q22",
      "chapterId": "ch09",
      "type": "single",
      "question": "Chinchilla 的粗略配比是？",
      "options": [
        "D≈2N",
        "D≈20N",
        "D≈200N",
        "D≈N/20"
      ],
      "answer": 1,
      "explain": "给定算力下约每个参数配 20 个 token；推理量大时应反向权衡。"
    },
    {
      "id": "q23",
      "chapterId": "ch10",
      "type": "single",
      "question": "70B、int4 权重显存约多少？",
      "options": [
        "约 35 GB",
        "约 70 GB",
        "约 140 GB",
        "约 17 GB"
      ],
      "answer": 0,
      "explain": "70e9×4/8≈35 GB；还要加 KV、激活与框架开销。"
