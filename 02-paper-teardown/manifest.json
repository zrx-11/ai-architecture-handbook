  "glossary": [
    {
      "term": "R1-Zero",
      "def": "V3-Base 直接做纯 RL、不做冷启动得到的推理模型。",
      "chapterId": "ch06"
    },
    {
      "term": "GRPO",
      "def": "用组内相对优势替代价值模型的策略优化算法。",
      "chapterId": "ch06"
    },
    {
      "term": "规则奖励",
      "def": "用确定性规则判分，如答案匹配、格式检查。",
      "chapterId": "ch06"
    },
    {
      "term": "冷启动",
      "def": "RL 前用少量高质量长链推理做 SFT，稳定格式。",
      "chapterId": "ch07"
    },
    {
      "term": "拒绝采样",
      "def": "生成多个回答，只保留达标样本做 SFT。",
      "chapterId": "ch07"
    },
    {
      "term": "知识蒸馏",
      "def": "让学生模型学习教师模型的输出。",
      "chapterId": "ch07"
    },
    {
      "term": "奖励黑客",
      "def": "模型钻奖励漏洞拿高分但没真完成任务。",
      "chapterId": "ch07"
    },
    {
      "term": "过程奖励模型（PRM）",
      "def": "给推理每一步打分的奖励模型，R1 尝试后未作主方案。",
      "chapterId": "ch07"
    },
    {
      "term": "MCTS",
      "def": "蒙特卡洛树搜索，R1 尝试后未作主方案。",
      "chapterId": "ch07"
    },
    {
      "term": "CSA",
      "def": "每 4 个 token 压 1 条再做 top-k 稀疏的注意力。",
      "chapterId": "ch08"
    },
    {
      "term": "HCA",
      "def": "每 128 个 token 压 1 条再做稠密注意力的注意力。",
      "chapterId": "ch08"
    },
    {
      "term": "mHC",
      "def": "用双随机矩阵混合多条残差流的超连接。",
      "chapterId": "ch08"
    },
    {
      "term": "Muon",
      "def": "对梯度矩阵做正交化的优化器。",
      "chapterId": "ch08"
    },
    {
      "term": "Sinkhorn-Knopp",
      "def": "交替行列归一化，把矩阵投影到双随机流形。",
      "chapterId": "ch08"
    },
    {
      "term": "双随机矩阵",
      "def": "行和、列和都为 1 的非负矩阵。",
      "chapterId": "ch08"
    },
    {
      "term": "CED",
      "def": "前半编码器、后半解码器，解码全局 KV 由编码器末端投影。",
      "chapterId": "ch09"
    },
    {
      "term": "CSA2",
      "def": "CSA 的跨层复用版本，有 Full/Reindex/Reuse 三模式。",
      "chapterId": "ch09"
    },
    {
      "term": "SWA",
      "def": "只看最近固定窗口的滑动窗口注意力。",
      "chapterId": "ch09"
    },
    {
      "term": "SWA Bounded Replay",
      "def": "只回放最近一个窗口重建 SWA 缓存。",
      "chapterId": "ch09"
    },
    {
      "term": "Engram",
      "def": "用哈希查表的条件记忆模块。",
      "chapterId": "ch09"
    },
    {
      "term": "DSpark",
      "def": "V4.1 独立训练的投机解码 drafter。",
      "chapterId": "ch09"
    },
    {
      "term": "FP4",
      "def": "4 位浮点量化，存储和带宽约为 FP16 的 1/4。",
      "chapterId": "ch09"
    },
    {
      "term": "全局 KV cache",
      "def": "常驻 HBM 的主 KV 缓存；V4.1 为 890 B/token。",
      "chapterId": "ch09"
    },
    {
      "term": "持久 KV cache",
      "def": "放 SSD/主机内存、用于前缀复用的缓存。",
      "chapterId": "ch09"
    },
    {
      "term": "预填充（prefill）",
      "def": "一次性读入整段输入并建立 KV cache。",
      "chapterId": "ch09"
    },
    {
      "term": "解码（decode）",
      "def": "逐 token 生成输出。",
      "chapterId": "ch09"
    }
  ],
