  "glossary": [
    {
      "term": "瓶颈迁移",
      "def": "部署瓶颈从 KV cache 转向 FLOPs 再转向 prefill/带宽。",
      "chapterId": "ch10"
    },
    {
      "term": "激活参数",
      "def": "单个 token 实际参与计算的参数。",
      "chapterId": "ch10"
    },
    {
      "term": "总参数",
      "def": "模型全部参数，MoE 中远大于激活参数。",
      "chapterId": "ch10"
    },
    {
      "term": "非对称架构",
      "def": "prefill 和 decode 走不同计算路径的架构。",
      "chapterId": "ch10"
    },
    {
      "term": "专家并行",
      "def": "把 MoE 专家分布到不同设备上。",
      "chapterId": "ch11"
    },
    {
      "term": "路由",
      "def": "决定 token 进入哪些专家的机制。",
      "chapterId": "ch11"
    },
    {
      "term": "双随机矩阵",
      "def": "行和、列和都为 1 的非负矩阵。",
      "chapterId": "ch11"
    },
    {
      "term": "正交化",
      "def": "把梯度矩阵的奇异值拉到接近 1。",
      "chapterId": "ch11"
    },
    {
      "term": "压缩维度",
      "def": "条目大小、序列长度、层数、位宽四个可压缩方向。",
      "chapterId": "ch11"
    },
    {
      "term": "prefill",
      "def": "读入整段输入并建立 KV cache 的阶段。",
      "chapterId": "ch12"
    },
    {
      "term": "decode",
      "def": "逐 token 生成输出的阶段。",
      "chapterId": "ch12"
    },
    {
      "term": "OPD",
      "def": "学生在自己轨迹上向多个教师做全词表蒸馏。",
      "chapterId": "ch12"
    },
    {
      "term": "GRM",
      "def": "生成式奖励模型，模型自己生成评分理由和分数。",
      "chapterId": "ch12"
    },
    {
      "term": "DSec",
      "def": "V4.1 用于大规模智能体 RL 的弹性计算沙箱。",
      "chapterId": "ch12"
    },
    {
      "term": "任务三元组",
      "def": "问题、环境、验证系统。",
      "chapterId": "ch12"
    },
    {
      "term": "effort",
      "def": "1–100 的推理力度标量，控制输出长度。",
      "chapterId": "ch12"
    },
    {
      "term": "全局 KV cache",
      "def": "常驻 HBM 的主 KV 缓存。",
      "chapterId": "ch13"
    },
    {
      "term": "持久 KV cache",
      "def": "放 SSD/主机内存、用于前缀复用的缓存。",
      "chapterId": "ch13"
    },
    {
      "term": "算术强度",
      "def": "每字节内存访问对应的计算量。",
      "chapterId": "ch13"
    },
    {
      "term": "选型",
      "def": "在负载、成本、质量约束下选最合适的模型。",
      "chapterId": "ch13"
    }
  ],
