      "relatedConceptId": "c02"
    },
    {
      "id": "q02",
      "chapterId": "ch01",
      "type": "single",
      "question": "对分数 [0, 0, 0] 做 softmax，输出是什么？",
      "options": [
        "[0, 0, 0]",
        "[1/3, 1/3, 1/3]",
        "[1, 0, 0]",
        "[3, 3, 3]"
      ],
      "answer": 1,
      "explain": "三个 e^0=1，总和 3，各占三分之一。",
      "relatedConceptId": "c03"
    },
    {
      "id": "q03",
