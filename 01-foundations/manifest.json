    {
      "id": "f03",
      "chapterId": "ch01",
      "front": "softmax 的两个关键性质？",
      "back": "输出非负、总和为 1，并且保持原有大小顺序。",
      "tags": [
        "基础",
        "softmax"
      ]
    },
    {
      "id": "f04",
      "chapterId": "ch01",
      "front": "embedding 表做什么？",
      "back": "把 token 编号映射成固定长度的向量。",
      "tags": [
        "基础",
        "embedding"
      ]
    },
    {
      "id": "f05",
      "chapterId": "ch02",
      "front": "参数、损失、梯度各是什么？",
      "back": "参数是可调旋钮，损失是差距分数，梯度是损失对参数的变化率。",
      "tags": [
        "训练",
        "基础"
      ]
    },
    {
      "id": "f06",
      "chapterId": "ch02",
      "front": "梯度下降的更新公式？",
      "back": "w ← w - η·∂L/∂w。",
      "tags": [
        "训练",
        "梯度"
      ]
    },
    {
      "id": "f07",
      "chapterId": "ch02",
      "front": "学习率过大和过小分别会怎样？",
      "back": "过大震荡或发散，过小学得慢。",
      "tags": [
        "训练",
        "学习率"
      ]
    },
    {
      "id": "f08",
      "chapterId": "ch02",
      "front": "过拟合是什么？",
      "back": "训练集损失很小，换一批数据表现变差。",
      "tags": [
        "训练",
        "泛化"
      ]
    },
    {
      "id": "f09",
      "chapterId": "ch03",
      "front": "Q、K、V 各自负责什么？",
      "back": "Q 找信息，K 提供标签，V 提供实际内容。",
      "tags": [
        "注意力",
        "QKV"
      ]
    },
    {
      "id": "f10",
      "chapterId": "ch03",
      "front": "注意力分数怎么算？",
      "back": "Q 与 K 点积，除以 sqrt(d_k)，再 softmax。",
      "tags": [
        "注意力",
        "公式"
      ]
    },
    {
      "id": "f11",
      "chapterId": "ch03",
      "front": "为什么要除以 sqrt(d_k)？",
      "back": "防止高维点积过大，softmax 过度集中导致梯度消失。",
      "tags": [
        "注意力",
        "缩放"
      ]
    },
    {
      "id": "f12",
      "chapterId": "ch03",
      "front": "因果掩码的作用？",
      "back": "把未来位置的分数设为负无穷，禁止模型偷看答案。",
      "tags": [
        "注意力",
        "掩码"
      ]
    },
    {
      "id": "f13",
      "chapterId": "ch04",
      "front": "Transformer 一层有哪两段？",
      "back": "多头注意力和前馈网络，各自带残差与归一化。",
      "tags": [
        "Transformer",
        "结构"
      ]
    },
    {
      "id": "f14",
      "chapterId": "ch04",
      "front": "残差连接的公式？",
      "back": "y = x + Layer(x)。",
      "tags": [
        "Transformer",
        "残差"
      ]
    },
    {
      "id": "f15",
      "chapterId": "ch04",
      "front": "RMSNorm 与 LayerNorm 的区别？",
      "back": "RMSNorm 不减均值，只除以均方根，计算更快。",
      "tags": [
        "Transformer",
        "归一化"
      ]
    },
    {
      "id": "f16",
      "chapterId": "ch04",
      "front": "FFN 的形状怎么变？",
      "back": "先升到约 4 倍中间维度，激活后再降回隐藏维度。",
      "tags": [
        "Transformer",
        "FFN"
      ]
    },
    {
      "id": "f17",
      "chapterId": "ch05",
      "front": "MLA 缓存什么？",
      "back": "低维潜向量 c_KV 和解耦的 RoPE key。",
      "tags": [
        "DeepSeek",
        "MLA"
      ]
    },
    {
      "id": "f18",
      "chapterId": "ch05",
      "front": "DeepSeekMoE 的结构？",
      "back": "1 个共享专家 + 多个细粒度路由专家，每 token 激活 top-k 个路由专家。",
      "tags": [
        "DeepSeek",
        "MoE"
      ]
    },
    {
      "id": "f19",
      "chapterId": "ch05",
      "front": "MTP 的训练目标？",
      "back": "在每个位置额外预测未来第 2 个 token。",
      "tags": [
        "DeepSeek",
        "MTP"
      ]
    },
    {
      "id": "f20",
      "chapterId": "ch05",
      "front": "无辅助损失负载均衡怎么做？",
      "back": "给每个专家一个可学习偏置，按负载调偏置，不往主损失加辅助项。",
      "tags": [
        "DeepSeek",
        "负载均衡"
      ]
    }
  ]
}