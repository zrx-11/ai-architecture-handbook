  "glossary": [
    {
      "term": "向量",
      "def": "一串有顺序的数字，长度叫维度。",
      "chapterId": "ch01"
    },
    {
      "term": "矩阵乘法",
      "def": "左矩阵每行与右矩阵每列做点积，得到新矩阵。",
      "chapterId": "ch01"
    },
    {
      "term": "softmax",
      "def": "把分数转成非负、总和为 1 的权重。",
      "chapterId": "ch01"
    },
    {
      "term": "token",
      "def": "模型处理文本的基本单位，可以是一个字、一个词或词的一部分。",
      "chapterId": "ch01"
    },
    {
      "term": "embedding",
      "def": "把 token 编号映射成固定长度向量的表。",
      "chapterId": "ch01"
    },
    {
      "term": "参数",
      "def": "模型里可训练的数值，比如矩阵元素。",
      "chapterId": "ch02"
    },
    {
      "term": "损失",
      "def": "衡量预测与正确答案差距的标量。",
      "chapterId": "ch02"
    },
    {
      "term": "梯度",
      "def": "损失对参数的变化率，指示更新方向。",
      "chapterId": "ch02"
    },
    {
      "term": "学习率",
      "def": "每次参数更新走多大的一步。",
      "chapterId": "ch02"
    },
    {
      "term": "过拟合",
      "def": "训练集上损失很小，换数据就变差。",
      "chapterId": "ch02"
    },
    {
      "term": "注意力",
      "def": "按 token 间相似度加权收集信息的机制。",
      "chapterId": "ch03"
    },
    {
      "term": "Q / K / V",
      "def": "查询、键、值，同一输入的三次投影。",
      "chapterId": "ch03"
    },
    {
      "term": "多头注意力",
      "def": "并行多套 Q/K/V，捕捉不同关系。",
      "chapterId": "ch03"
    },
    {
      "term": "因果掩码",
      "def": "禁止每个 token 看到未来 token。",
      "chapterId": "ch03"
    },
    {
      "term": "残差连接",
      "def": "把子层输入加到子层输出。",
      "chapterId": "ch04"
    },
    {
      "term": "RMSNorm",
      "def": "用均方根缩放向量的归一化。",
      "chapterId": "ch04"
    },
    {
      "term": "FFN",
      "def": "对每个 token 独立做升维-激活-降维。",
      "chapterId": "ch04"
    },
    {
      "term": "自回归生成",
      "def": "逐个预测下一个 token 并接回输入。",
      "chapterId": "ch04"
    },
    {
      "term": "MLA",
      "def": "用低维潜向量压缩 KV cache 的注意力。",
      "chapterId": "ch05"
    },
    {
      "term": "DeepSeekMoE",
      "def": "共享专家 + 细粒度路由专家的混合专家结构。",
      "chapterId": "ch05"
    },
    {
      "term": "MTP",
      "def": "训练时额外预测未来第 2 个 token。",
      "chapterId": "ch05"
    },
    {
      "term": "KV cache",
      "def": "推理时缓存历史 token 的 K/V。",
      "chapterId": "ch05"
    },
    {
      "term": "专家塌缩",
      "def": "MoE 路由总选少数专家，其他专家学不到东西。",
      "chapterId": "ch05"
    }
  ],
